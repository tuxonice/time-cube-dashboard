{% extends "auth_layout.twig" %}

{% block title %}500 — Internal Server Error{% endblock %}

{% block header %}
    <h4 class="fw-bold mb-1">Something went wrong</h4>
    <p class="text-muted small mb-0">An unexpected error occurred</p>
{% endblock %}

{% block content %}
<div class="text-center py-2">
    <div class="mb-4" style="font-size: 3rem; line-height: 1;">
        <i class="bi bi-exclamation-triangle text-warning"></i>
    </div>
    <p class="text-muted mb-4">
        We're having trouble processing your request right now.<br>
        The issue has been logged and we'll look into it.
    </p>
    <a href="/" class="btn btn-dark">Go to dashboard</a>
</div>
{% endblock %}