{% extends "layout.twig" %}

{% set active_page = 'projects' %}

{% block title %}Edit Project — Time Cube{% endblock %}

{% block breadcrumb %}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-0 small">
        <li class="breadcrumb-item"><a href="/projects" class="text-decoration-none">Projects</a></li>
        <li class="breadcrumb-item active">Edit</li>
    </ol>
</nav>
{% endblock %}

{% block content %}
<h1 class="mt-4 mb-4">Edit Project</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post" action="/projects/{{ project.id }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <div class="mb-3">
                <label class="form-label" for="name">Name</label>
                <input type="text" id="name" name="name" class="form-control" value="{{ project.name }}" required autofocus>
            </div>
            <div class="mb-4">
                <label class="form-label" for="description">Description</label>
                <textarea id="description" name="description" class="form-control" rows="3">{{ project.description }}</textarea>
            </div>
            <button type="submit" class="btn btn-dark">
                <i aria-hidden="true" class="bi bi-check-lg me-1"></i> Update Project
            </button>
            <a href="/projects" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
{% endblock %}
