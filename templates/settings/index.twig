{% extends "layout.twig" %}

{% set active_page = 'settings' %}

{% block title %}Settings — Time Cube{% endblock %}

{% block breadcrumb %}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-0 small">
        <li class="breadcrumb-item active">Settings</li>
    </ol>
</nav>
{% endblock %}

{% block content %}
<h1 class="mt-4 mb-4">Settings</h1>

<!-- API Tokens -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i aria-hidden="true" class="bi bi-key me-2"></i>API Tokens</h5>
    </div>
    <div class="card-body">
        <p class="text-muted small">API tokens are used by the Time Cube device (ESP32) to authenticate with the API. Create a token and configure it on your device.</p>

        <!-- Create token form -->
        <form method="post" action="/settings/tokens" class="row g-2 align-items-end mb-4">
            <div class="col-auto flex-grow-1">
                <label class="form-label" for="token-name">Token name</label>
                <input type="text" id="token-name" name="name" class="form-control" placeholder="e.g. Office Cube" required>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-dark">
                    <i aria-hidden="true" class="bi bi-plus-lg me-1"></i> Create Token
                </button>
            </div>
        </form>

        {% if tokens is not empty %}
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Token</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for token in tokens %}
                    <tr>
                        <td class="fw-semibold">{{ token.name }}</td>
                        <td><code>{{ token.token[:8] }}...{{ token.token[-4:] }}</code></td>
                        <td class="text-muted">{{ token.created_at }}</td>
                        <td class="text-end">
                            <form action="/settings/tokens/{{ token.id }}/delete" method="post" class="d-inline"
                                  onsubmit="return confirm('Revoke this token? The device using it will lose access.')">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i aria-hidden="true" class="bi bi-trash"></i> Revoke
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <p class="text-muted mb-0">No API tokens yet.</p>
        {% endif %}
    </div>
</div>

<!-- API Documentation -->
<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i aria-hidden="true" class="bi bi-book me-2"></i>API Endpoints</h5>
    </div>
    <div class="card-body">
        <p class="text-muted small">All API requests require the header: <code>Authorization: Bearer YOUR_TOKEN</code></p>

        <table class="table table-sm mb-2">
            <thead>
                <tr>
                    <th>Method</th>
                    <th>Endpoint</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><span class="badge bg-success">POST</span></td>
                    <td><code>/api/cube</code></td>
                    <td>Cube reports its face — dashboard starts the mapped task timer (stops any running one)</td>
                </tr>
            </tbody>
        </table>
        <p class="text-muted small mb-1">Payload:</p>
        <pre class="bg-light p-3 rounded small mb-0">{"cubeId": "cube-123abc", "face": "yellow"}</pre>
    </div>
</div>
{% endblock %}
