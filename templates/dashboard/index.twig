{% extends "layout.twig" %}

{% set active_page = 'dashboard' %}

{% block title %}Dashboard — Time Cube{% endblock %}

{% block content %}
<h1 class="mt-4">Dashboard</h1>
<p class="text-muted">Overview of your time tracking</p>

<!-- Active Timer -->
{% if running %}
<div class="card shadow-sm border-start border-success border-4 mt-4">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <div class="text-muted small">Timer running</div>
            <strong>{{ running.project_name }}</strong> / {{ running.task_name }}
            <div class="timer-display timer-running mt-1" id="timer" data-started="{{ running.started_at }}">00:00:00</div>
        </div>
        <form action="/time/{{ running.id }}/stop" method="post">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <button type="submit" class="btn btn-danger">
                <i aria-hidden="true" class="bi bi-stop-circle me-1"></i> Stop
            </button>
        </form>
    </div>
</div>
{% endif %}

<!-- Stats -->
<div class="row g-4 mt-3">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width:48px;height:48px;">
                        <i aria-hidden="true" class="bi bi-folder fs-5"></i>
                    </div>
                    <div>
                        <h2 class="mb-0">{{ project_count }}</h2>
                        <div class="text-muted small">Projects</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center flex-shrink-0" style="width:48px;height:48px;">
                        <i aria-hidden="true" class="bi bi-clock-history fs-5"></i>
                    </div>
                    <div>
                        <h2 class="mb-0">{{ (total_seconds / 3600)|number_format(1) }}h</h2>
                        <div class="text-muted small">Total Time</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center flex-shrink-0" style="width:48px;height:48px;">
                        <i aria-hidden="true" class="bi bi-calendar-day fs-5"></i>
                    </div>
                    <div>
                        <h2 class="mb-0">{{ (today_seconds / 3600)|number_format(1) }}h</h2>
                        <div class="text-muted small">Today</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Per-project breakdown -->
<h2 class="mt-5 mb-3">Time by Project</h2>

{% if projects is empty %}
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-folder-plus text-muted" style="font-size: 2rem;"></i>
            <p class="text-muted mt-2 mb-3">No projects yet.</p>
            <a href="/projects/create" class="btn btn-dark">
                <i aria-hidden="true" class="bi bi-plus-lg me-1"></i> Create your first project
            </a>
        </div>
    </div>
{% else %}
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Project</th>
                        <th>Tasks</th>
                        <th>Total Time</th>
                    </tr>
                </thead>
                <tbody>
                    {% for project in projects %}
                    <tr>
                        <td><a href="/projects/{{ project.id }}/tasks" class="text-decoration-none fw-semibold">{{ project.name }}</a></td>
                        <td>{{ project.task_count }}</td>
                        <td>{{ (project.total_seconds / 3600)|number_format(1) }}h</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
{% endblock %}

{% block scripts %}
{% if running %}
<script src="/js/timer.js"></script>
{% endif %}
{% endblock %}
