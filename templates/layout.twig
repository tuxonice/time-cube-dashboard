<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% block title %}Time Cube{% endblock %}</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Shared styles -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
<a class="visually-hidden-focusable" href="#main-content">Skip to main content</a>
<div class="layout-wrapper">

    <!-- Sidebar -->
    <aside id="sidebar" class="sidebar">
        <h4 class="mb-4"><i aria-hidden="true" class="bi bi-clock-history me-2"></i>Time Cube</h4>
        <nav class="nav flex-column" aria-label="Sidebar navigation">
            <a class="nav-link{% if active_page is defined and active_page == 'dashboard' %} active{% endif %}" href="/">
                <i aria-hidden="true" class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
            <a class="nav-link{% if active_page is defined and active_page == 'projects' %} active{% endif %}" href="/projects">
                <i aria-hidden="true" class="bi bi-folder me-2"></i> Projects
            </a>
            <a class="nav-link{% if active_page is defined and active_page == 'cubes' %} active{% endif %}" href="/cubes">
                <i aria-hidden="true" class="bi bi-dice-6 me-2"></i> Cubes
            </a>
            <hr class="border-secondary my-2">
            <a class="nav-link{% if active_page is defined and active_page == 'settings' %} active{% endif %}" href="/settings">
                <i aria-hidden="true" class="bi bi-gear me-2"></i> Settings
            </a>
            <hr class="border-secondary my-2">
            <form action="/logout" method="post">
                <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start" style="color: #cbd5e1;">
                    <i aria-hidden="true" class="bi bi-box-arrow-right me-2"></i> Logout
                </button>
            </form>
        </nav>
    </aside>
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <!-- Main Content -->
    <main class="content" id="main-content">

        <!-- Topbar -->
        <div class="topbar d-flex justify-content-between align-items-center">
            <button class="btn btn-outline-secondary d-lg-none" id="menu-btn" aria-label="Toggle navigation">
                <i aria-hidden="true" class="bi bi-list"></i>
            </button>

            <div class="ms-2 ms-lg-0">
                {% block breadcrumb %}{% endblock %}
            </div>

            <div class="ms-auto d-flex align-items-center gap-3">
                {% if auth %}
                <div class="dropdown">
                    <button class="btn btn-link text-dark p-0 border-0 d-flex align-items-center gap-2" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                        {% if auth.avatar %}
                            <img src="/uploads/avatars/{{ auth.avatar }}" alt="{{ auth.username }}"
                                 class="rounded-circle border" style="width:32px;height:32px;object-fit:cover;">
                        {% else %}
                            <i aria-hidden="true" class="bi bi-person-circle fs-5"></i>
                        {% endif %}
                        <span class="d-none d-md-inline small fw-semibold">{{ auth.username }}</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li>
                            <div class="px-3 py-2 border-bottom">
                                <div class="fw-semibold">{{ auth.username }}</div>
                            </div>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" href="/profile">
                                <i aria-hidden="true" class="bi bi-person"></i> Profile
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form action="/logout" method="post">
                                <button type="submit" class="dropdown-item d-flex align-items-center gap-2 text-danger">
                                    <i aria-hidden="true" class="bi bi-box-arrow-right"></i> Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Flash Messages -->
        {% if flash %}
        <div class="alert alert-{{ flash.type == 'error' ? 'danger' : flash.type }} alert-dismissible fade show mt-4" role="alert">
            {{ flash.message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        {% endif %}

        <!-- Page Content -->
        {% block content %}{% endblock %}

        <!-- Footer -->
        <footer class="mt-4 pt-4 pb-3 border-top">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="text-muted small">&copy; 2026 Time Cube. All rights reserved.</span>
            </div>
        </footer>

    </main>
</div>

<!-- Bootstrap & JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
