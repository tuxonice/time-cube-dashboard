{% extends "layout.twig" %}

{% block title %}Profile — Time Cube{% endblock %}

{% block breadcrumb %}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-0 small">
        <li class="breadcrumb-item active">Profile</li>
    </ol>
</nav>
{% endblock %}

{% block content %}
<h1 class="mt-4 mb-4">Profile</h1>

<!-- Avatar -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i aria-hidden="true" class="bi bi-image me-2"></i>Avatar</h5>
    </div>
    <div class="card-body">
        <div class="d-flex align-items-center gap-4 mb-4">
            {% if auth.avatar %}
                <img src="/uploads/avatars/{{ auth.avatar }}" alt="Your avatar"
                     class="rounded-circle border" style="width:80px;height:80px;object-fit:cover;">
            {% else %}
                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center border"
                     style="width:80px;height:80px;">
                    <i aria-hidden="true" class="bi bi-person-fill text-white fs-2"></i>
                </div>
            {% endif %}
            <div>
                <p class="mb-1 small text-muted">JPEG, PNG, GIF or WebP · max 2 MB</p>
                {% if auth.avatar %}
                    <form method="post" action="/profile/avatar/remove"
                          onsubmit="return confirm('Remove your avatar?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i aria-hidden="true" class="bi bi-trash me-1"></i>Remove
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>

        <form method="post" action="/profile/avatar" enctype="multipart/form-data"
              class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label" for="avatar">Upload new avatar</label>
                <input type="file" id="avatar" name="avatar" class="form-control"
                       accept="image/jpeg,image/png,image/gif,image/webp" required>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-dark">Upload</button>
            </div>
        </form>
    </div>
</div>

<!-- Username -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i aria-hidden="true" class="bi bi-person me-2"></i>Username</h5>
    </div>
    <div class="card-body">
        <form method="post" action="/profile">
            <input type="hidden" name="section" value="username">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label" for="username">Username</label>
                    <input type="text" id="username" name="username" class="form-control"
                           value="{{ auth.username }}" minlength="3" required>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-dark">Save</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Password -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i aria-hidden="true" class="bi bi-shield-lock me-2"></i>Change Password</h5>
    </div>
    <div class="card-body">
        <form method="post" action="/profile">
            <input type="hidden" name="section" value="password">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="current_password">Current password</label>
                    <input type="password" id="current_password" name="current_password" class="form-control" required>
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <label class="form-label" for="new_password">New password</label>
                    <input type="password" id="new_password" name="new_password" class="form-control" minlength="6" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="new_password_confirm">Confirm new password</label>
                    <input type="password" id="new_password_confirm" name="new_password_confirm" class="form-control" required>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-dark">Update Password</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}