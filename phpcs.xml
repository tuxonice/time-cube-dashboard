<?xml version="1.0"?>
<ruleset name="TimeCubeDashboard">
    <description>PHP_CodeSniffer configuration for Time Cube Dashboard</description>

    <!-- Show progress and use colors -->
    <arg value="p"/>
    <arg name="colors"/>

    <!-- Paths to check -->
    <file>src/</file>
    <file>public/index.php</file>
    <file>config/</file>
    <file>database/migrations/</file>

    <!-- Exclude vendor and other directories -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/templates/*</exclude-pattern>
    <exclude-pattern>*/database/app.db</exclude-pattern>

    <!-- Use PSR-12 coding standard -->
    <rule ref="PSR12"/>

    <!-- Additional rules -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="150"/>
        </properties>
    </rule>

    <!-- Allow longer lines in migration files -->
    <rule ref="Generic.Files.LineLength.TooLong">
        <exclude-pattern>*/database/migrations/*</exclude-pattern>
    </rule>

    <!-- Ignore missing namespace in public/index.php -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>*/public/index.php</exclude-pattern>
    </rule>
</ruleset>
