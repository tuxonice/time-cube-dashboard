# Environment Configuration
# This file is loaded by Symfony DotEnv component
# Copy this file to .env and configure your settings
# The .env file is gitignored and should not be committed

# Docker User Mapping
# Set these to match your host user to avoid permission issues
# Run: id -u (for USER_ID) and id -g (for GROUP_ID)
USER_ID=1000
GROUP_ID=1000

# GeoIP Access Control
# Comma-separated list of allowed country codes (ISO 3166-1 alpha-2)
# Leave empty to allow all countries
# Example: ALLOWED_COUNTRIES=US,GB,DE,FR,ES
ALLOWED_COUNTRIES=
