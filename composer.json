{
    "name": "tuxonice/time-cube-dashboard",
    "description": "Time booking management with projects and tasks",
    "type": "project",
    "require": {
        "php": "^8.3",
        "twig/twig": "^3.0",
        "symfony/http-foundation": "^6.0",
        "doctrine/dbal": "^3.0",
        "doctrine/migrations": "^3.0",
        "symfony/cache": "^6.0",
        "symfony/dotenv": "^6.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan": "^1.10",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-faker": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=256M",
        "phpstan:baseline": "phpstan analyse --memory-limit=256M --generate-baseline",
        "test": "pest",
        "test:coverage": "pest --coverage",
        "test:parallel": "pest --parallel"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
